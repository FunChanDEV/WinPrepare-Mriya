<!--
  OPTIONAL alternative hook (you normally do NOT need this if you use
  SetupComplete.cmd).

  If you prefer to start WinPrepare from FirstLogonCommands instead, merge
  the SynchronousCommand below into your existing autounattend.xml, inside:

    <unattend ...>
      <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35" language="neutral"
                   versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <FirstLogonCommands>
            ... your existing <SynchronousCommand wcm:action="add"> entries ...
            + the entry below (Order must be HIGHER than your last existing Order)
          </FirstLogonCommands>
        </component>
      </settings>
    </unattend>

  Note: if you use this hook instead of SetupComplete.cmd, remove
  SetupComplete.cmd from the USB drive. FirstLogonCommands may run without
  elevation; the schneegans generator has a "run elevated" option for custom
  scripts - prefer that route, or keep SetupComplete.cmd (always SYSTEM).
-->
<SynchronousCommand wcm:action="add" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
	<Order>90</Order>
	<CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:\Windows\Setup\Scripts\WinPrepare\Bootstrap.ps1"</CommandLine>
	<Description>WinPrepare bootstrap (Wi-Fi, updates, domain join)</Description>
</SynchronousCommand>
