<?xml version="1.0"?>
<!-- Wi-Fi profile: MRS.Mobile, WPA2-PSK (AES). Imported with "user=all" so
     the connection also works before/without an interactive user session. -->
<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">
	<name>MRS.Mobile</name>
	<SSIDConfig>
		<SSID>
			<hex>4D52532E4D6F62696C65</hex>
			<name>MRS.Mobile</name>
		</SSID>
	</SSIDConfig>
	<connectionType>ESS</connectionType>
	<connectionMode>auto</connectionMode>
	<MSM>
		<security>
			<authEncryption>
				<authentication>WPA2PSK</authentication>
				<encryption>AES</encryption>
				<useOneX>false</useOneX>
			</authEncryption>
			<sharedKey>
				<keyType>passPhrase</keyType>
				<protected>false</protected>
				<keyMaterial>Mriya2023!</keyMaterial>
			</sharedKey>
		</security>
	</MSM>
</WLANProfile>
