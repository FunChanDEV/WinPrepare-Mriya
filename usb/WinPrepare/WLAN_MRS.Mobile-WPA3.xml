<?xml version="1.0"?>
<!-- Fallback Wi-Fi profile for access points that only accept WPA3-SAE.
     Same SSID, distinct profile name so both profiles can coexist. -->
<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">
	<name>MRS.Mobile-WPA3</name>
	<SSIDConfig>
		<SSID>
			<hex>4D52532E4D6F62696C65</hex>
			<name>MRS.Mobile</name>
		</SSID>
	</SSIDConfig>
	<connectionType>ESS</connectionType>
	<connectionMode>auto</connectionMode>
	<MSM>
		<security>
			<authEncryption>
				<authentication>WPA3SAE</authentication>
				<encryption>AES</encryption>
				<useOneX>false</useOneX>
			</authEncryption>
			<sharedKey>
				<keyType>passPhrase</keyType>
				<protected>false</protected>
				<keyMaterial>Mriya2023!</keyMaterial>
			</sharedKey>
		</security>
	</MSM>
</WLANProfile>
